NAME Shift with a letter never switches when Caps Lock is chosen
PROFILES all
LANG english
TEXT "|"
# QUESTION: The contract has no switchKey setup step; this case requires switchKey=capsLock.
# QUESTION: Does KEY shift+a denote a held Shift chord to the runner, including both flagsChanged events?
KEY shift+a
EXPECT doc "A"
EXPECT lang english
EXPECT switches 0
