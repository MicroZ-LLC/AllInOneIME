{ "language": "python", "title": "Python", "version": "1.0.0",
  "keywords": ["def", "class", "return", "lambda", "import", "from", "while", "yield", "async", "await", "elif", "else",
               "except", "finally", "global", "nonlocal", "pass", "raise", "with", "assert", "break", "continue"],
  "snippets": [
