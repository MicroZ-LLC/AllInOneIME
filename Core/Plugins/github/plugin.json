{
  "name": "github",
  "version": "1.0.1",
  "api": 1,
  "minAppVersion": "0.6.7",
  "type": "script",
  "summary": { "en": "GitHub issues as you type: #12 → #1234 Fix login; @github login to search", "zh": "边打边补 GitHub issue：#12 → #1234 修登录；@github 登录 搜索" },
  "script": "main.js",
  "hosts": ["api.github.com"],
  "timeoutSeconds": 15,
  "icon": "number",
  "color": "gray",
  "author": "MicroZ LLC",
  "homepage": "https://github.com/MicroZ-LLC/AllInOneIME-plugins",
  "preferences": [
    { "name": "repos", "type": "text", "title": { "en": "Repositories", "zh": "仓库" },
      "placeholder": "owner/repo, owner/other", "default": "MicroZ-LLC/AllInOneIME" },
    { "name": "token", "type": "password", "title": { "en": "Token (optional, for private repositories)", "zh": "Token（可选，私有仓库用）" } }
  ],
  "completions": [
    { "name": "issues", "title": { "en": "GitHub issues", "zh": "GitHub issue" },
      "prefix": "#", "minChars": 1, "compare": "prefix",
      "list": true, "refresh": "15m",
      "query": true, "queryMinChars": 2,
      "insert": { "default": ["{arg} {title}", "{arg}"], "chat": ["{arg} {title} {url}", "{arg} {url}", "{arg}"], "terminal": "{match}" } }
  ]
}
