    "Space picks · type @ first for commands" : {
      "comment" : "空格 选词 · 开头打 @ 用命令 — Sources/AllInOneIMECore/Session/PanelPresenter.swift",
      "localizations" : {
        "de" : {
          "stringUnit" : {
