{ "language": "typescript", "title": "TypeScript", "version": "1.0.1",
  "keywords": ["break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do", "else",
               "enum", "export", "extends", "false", "finally", "for", "function", "if", "import", "in", "instanceof",
               "new", "null", "return", "super", "switch", "this", "throw", "true", "try", "typeof", "var", "void",
               "while", "implements", "interface", "let", "private", "protected", "public", "static", "yield",
               "abstract", "as", "async", "await", "constructor", "declare", "get", "set", "infer", "is", "keyof",
               "namespace", "never", "of", "readonly", "satisfies", "override", "type", "from", "asserts", "any",
               "unknown", "boolean", "number", "string", "symbol", "bigint", "object", "undefined"],
  "builtins": ["Array", "Object", "Promise", "Map", "Set", "Record", "Partial", "Required", "Readonly", "Pick", "Omit",
               "ReturnType", "JSON", "Math", "Date", "Error", "RegExp", "Symbol", "parseInt", "parseFloat",
               "setTimeout", "setInterval", "fetch", "document", "window", "log", "length", "push", "forEach", "filter",
               "reduce", "includes"],
  "snippets": [
    { "trigger": "function", "body": "function ${1:name}(${2}): ${3:void} {\n  $0\n}", "title": "function" },
    { "trigger": "async", "body": "async function ${1:name}(${2}): Promise<${3:void}> {\n  $0\n}", "title": "async function" },
    { "trigger": "const", "body": "const ${1:name} = (${2}) => {\n  $0\n};", "title": "arrow function" },
    { "trigger": "class", "body": "class ${1:Name} {\n  constructor(${2}) {\n    $0\n  }\n}", "title": "class" },
    { "trigger": "constructor", "body": "constructor(${1}) {\n  $0\n}", "title": "constructor" },
    { "trigger": "interface", "body": "interface ${1:Name} {\n  $0\n}", "title": "interface" },
    { "trigger": "type", "body": "type ${1:Name} = {\n  $0\n};", "title": "type alias" },
    { "trigger": "enum", "body": "enum ${1:Name} {\n  $0\n}", "title": "enum" },
    { "trigger": "if", "body": "if (${1:condition}) {\n  $0\n}", "title": "if" },
    { "trigger": "if", "body": "if (${1:condition}) {\n  $0\n} else {\n}", "title": "if/else" },
    { "trigger": "else", "body": "else {\n  $0\n}", "title": "else" },
    { "trigger": "else", "body": "else if (${1:condition}) {\n  $0\n}", "title": "else if" },
    { "trigger": "for", "body": "for (let i = 0; i < ${1:n}; i++) {\n  $0\n}", "title": "for loop" },
    { "trigger": "for", "body": "for (const ${1:item} of ${2:items}) {\n  $0\n}", "title": "for…of" },
    { "trigger": "while", "body": "while (${1:condition}) {\n  $0\n}", "title": "while" },
    { "trigger": "switch", "body": "switch (${1:value}) {\n  case ${2:1}:\n    $0\n    break;\n  default:\n    break;\n}", "title": "switch" },
    { "trigger": "try", "body": "try {\n  $0\n} catch (error) {\n  console.error(error);\n}", "title": "try/catch" },
    { "trigger": "import", "body": "import { ${1:name} } from \"${2:module}\";$0", "title": "import { … }" },
    { "trigger": "import", "body": "import ${1:name} from \"${2:module}\";$0", "title": "import default" },
    { "trigger": "export", "body": "export function ${1:name}(${2}): ${3:void} {\n  $0\n}", "title": "export function" },
    { "trigger": "export", "body": "export const ${1:name} = $0;", "title": "export const" },
    { "trigger": "console", "body": "console.log($0);", "title": "console.log" },
    { "trigger": "setTimeout", "body": "setTimeout(() => {\n  $0\n}, ${1:1000});", "title": "setTimeout" },
    { "trigger": "throw", "body": "throw new Error(\"$0\");", "title": "throw new Error" } ] }
