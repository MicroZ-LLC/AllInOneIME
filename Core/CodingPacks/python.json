{ "language": "python", "title": "Python", "version": "1.0.0",
  "keywords": ["False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def",
               "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is",
               "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield",
               "match", "case", "type",
               "self", "cls", "__init__", "__name__",
               "len", "range", "enumerate", "zip", "map", "filter", "sorted", "reversed", "sum", "min", "max", "abs",
               "round", "int", "float", "str", "bool", "list", "dict", "set", "tuple", "bytes", "frozenset",
               "isinstance", "hasattr", "getattr", "setattr", "open", "input", "super", "object", "iter", "next",
               "any", "all", "repr", "format", "chr", "ord", "divmod", "callable", "hash", "staticmethod",
               "classmethod", "property",
               "Exception", "ValueError", "TypeError", "KeyError", "IndexError", "RuntimeError", "AttributeError",
               "NotImplementedError", "StopIteration", "ZeroDivisionError", "FileNotFoundError", "OSError"],
  "snippets": [
    { "trigger": "def", "body": "def ${1:name}(${2}):\n    $0", "title": "function" },
    { "trigger": "def", "body": "def ${1:name}(self${2}):\n    $0", "title": "method" },
    { "trigger": "async", "body": "async def ${1:name}(${2}):\n    $0", "title": "async function" },
    { "trigger": "class", "body": "class ${1:Name}:\n    def __init__(self${2}):\n        $0", "title": "class with __init__" },
    { "trigger": "if", "body": "if ${1:condition}:\n    $0", "title": "if" },
    { "trigger": "if", "body": "if ${1:condition}:\n    $0\nelse:\n    ${2:pass}", "title": "if/else" },
    { "trigger": "if", "body": "if __name__ == \"__main__\":\n    ${1:main()}$0", "title": "main guard" },
    { "trigger": "elif", "body": "elif ${1:condition}:\n    $0", "title": "elif" },
    { "trigger": "else", "body": "else:\n    $0", "title": "else" },
    { "trigger": "for", "body": "for ${1:item} in ${2:items}:\n    $0", "title": "for … in" },
    { "trigger": "for", "body": "for ${1:i} in range(${2:n}):\n    $0", "title": "for … in range" },
    { "trigger": "for", "body": "for ${1:i}, ${2:item} in enumerate(${3:items}):\n    $0", "title": "for … in enumerate" },
    { "trigger": "while", "body": "while ${1:condition}:\n    $0", "title": "while" },
    { "trigger": "while", "body": "while True:\n    $0", "title": "while True" },
    { "trigger": "try", "body": "try:\n    $0\nexcept ${1:Exception} as e:\n    ${2:print(e)}", "title": "try/except" },
    { "trigger": "try", "body": "try:\n    $0\nfinally:\n    ${1:pass}", "title": "try/finally" },
    { "trigger": "with", "body": "with open(${1:path}) as ${2:f}:\n    $0", "title": "with open" },
    { "trigger": "with", "body": "with ${1:context} as ${2:name}:\n    $0", "title": "with … as" },
    { "trigger": "import", "body": "import ${1:module}$0", "title": "import" },
    { "trigger": "from", "body": "from ${1:module} import ${2:name}$0", "title": "from … import" },
    { "trigger": "lambda", "body": "lambda ${1:x}: $0", "title": "lambda" },
    { "trigger": "print", "body": "print($0)", "title": "print" },
    { "trigger": "raise", "body": "raise ${1:ValueError}($0)", "title": "raise" },
    { "trigger": "match", "body": "match ${1:value}:\n    case ${2:1}:\n        $0\n    case _:\n        ${3:pass}", "title": "match/case" } ] }
