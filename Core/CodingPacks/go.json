{ "language": "go", "title": "Go", "version": "1.0.0",
  "keywords": ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go",
               "goto", "if", "import", "interface", "map", "package", "range", "return", "select", "struct", "switch",
               "type", "var",
               "bool", "byte", "rune", "string", "error", "int", "int8", "int16", "int32", "int64", "uint", "uint8",
               "uint16", "uint32", "uint64", "float32", "float64", "any", "comparable", "true", "false", "iota", "nil",
               "append", "cap", "clear", "close", "copy", "delete", "len", "make", "max", "min", "new", "panic",
               "recover",
               "Println", "Printf", "Sprintf", "Errorf", "errors", "strings", "strconv"],
  "snippets": [
    { "trigger": "func", "body": "func ${1:name}(${2}) {\n\t$0\n}", "title": "function" },
    { "trigger": "func", "body": "func (${1:r} ${2:*T}) ${3:name}(${4}) {\n\t$0\n}", "title": "method" },
    { "trigger": "func", "body": "func main() {\n\t$0\n}", "title": "main function" },
    { "trigger": "package", "body": "package main\n\nfunc main() {\n\t$0\n}", "title": "main package" },
    { "trigger": "import", "body": "import \"${1:fmt}\"$0", "title": "import" },
    { "trigger": "import", "body": "import (\n\t\"${1:fmt}\"$0\n)", "title": "import block" },
    { "trigger": "if", "body": "if ${1:condition} {\n\t$0\n}", "title": "if" },
    { "trigger": "if", "body": "if ${1:condition} {\n\t$0\n} else {\n}", "title": "if/else" },
    { "trigger": "if", "body": "if err != nil {\n\treturn ${1:err}$0\n}", "title": "if err != nil" },
    { "trigger": "else", "body": "else {\n\t$0\n}", "title": "else" },
    { "trigger": "for", "body": "for i := 0; i < ${1:n}; i++ {\n\t$0\n}", "title": "for loop" },
    { "trigger": "for", "body": "for ${1:_}, ${2:v} := range ${3:items} {\n\t$0\n}", "title": "for range" },
    { "trigger": "for", "body": "for ${1:condition} {\n\t$0\n}", "title": "for condition (while)" },
    { "trigger": "switch", "body": "switch ${1:value} {\ncase ${2:1}:\n\t$0\ndefault:\n}", "title": "switch" },
    { "trigger": "type", "body": "type ${1:Name} struct {\n\t$0\n}", "title": "struct type" },
    { "trigger": "type", "body": "type ${1:Name} interface {\n\t$0\n}", "title": "interface type" },
    { "trigger": "go", "body": "go func() {\n\t$0\n}()", "title": "goroutine" },
    { "trigger": "defer", "body": "defer func() {\n\t$0\n}()", "title": "deferred function" },
    { "trigger": "fmt", "body": "fmt.Println($0)", "title": "fmt.Println" },
    { "trigger": "fmt", "body": "fmt.Printf(\"${1:%v}\\n\", $0)", "title": "fmt.Printf" },
    { "trigger": "fmt", "body": "fmt.Errorf(\"${1:context}: %w\", ${2:err})$0", "title": "fmt.Errorf (wrap)" },
    { "trigger": "errors", "body": "errors.New(\"$0\")", "title": "errors.New" },
    { "trigger": "make", "body": "make([]${1:int}, ${2:n})$0", "title": "make slice" },
    { "trigger": "make", "body": "make(map[${1:string}]${2:int})$0", "title": "make map" } ] }
