{ "language": "cpp", "title": "C++", "version": "1.0.1",
  "keywords": ["alignas", "alignof", "and", "and_eq", "asm", "auto", "bitand", "bitor", "bool", "break", "case", "catch",
               "char", "char8_t", "char16_t", "char32_t", "class", "compl", "concept", "const", "consteval",
               "constexpr", "constinit", "const_cast", "continue", "co_await", "co_return", "co_yield", "decltype",
               "default", "delete", "do", "double", "dynamic_cast", "else", "enum", "explicit", "export", "extern",
               "false", "float", "for", "friend", "goto", "if", "inline", "int", "long", "mutable", "namespace", "new",
               "noexcept", "not", "not_eq", "nullptr", "operator", "or", "or_eq", "private", "protected", "public",
               "reinterpret_cast", "requires", "return", "short", "signed", "sizeof", "static", "static_assert",
               "static_cast", "struct", "switch", "template", "this", "thread_local", "throw", "true", "try", "typedef",
               "typeid", "typename", "union", "unsigned", "using", "virtual", "void", "volatile", "wchar_t", "while",
               "xor", "xor_eq", "final", "override", "include", "define", "ifdef", "ifndef", "endif", "pragma", "undef"],
  "builtins": ["std", "cerr", "endl", "string", "vector", "array", "map", "unordered_map", "set", "unordered_set", "pair",
               "make_pair", "tuple", "deque", "queue", "priority_queue", "stack", "optional", "unique_ptr",
               "shared_ptr", "make_unique", "make_shared", "size_t", "begin", "end", "size", "push_back",
               "emplace_back", "swap", "move", "min", "max", "iostream", "algorithm"],
  "snippets": [
    { "trigger": "int", "body": "int main() {\n    $0\n}", "title": "main function" },
    { "trigger": "int", "body": "int main(int argc, char* argv[]) {\n    $0\n}", "title": "main with arguments" },
    { "trigger": "include", "body": "include <${1:iostream}>$0", "title": "#include <…>" },
    { "trigger": "include", "body": "include \"${1:header.h}\"$0", "title": "#include \"…\"" },
    { "trigger": "pragma", "body": "pragma once$0", "title": "#pragma once" },
    { "trigger": "using", "body": "using namespace std;$0", "title": "using namespace std" },
    { "trigger": "class", "body": "class ${1:Name} {\npublic:\n    $0\n};", "title": "class" },
    { "trigger": "struct", "body": "struct ${1:Name} {\n    $0\n};", "title": "struct" },
    { "trigger": "template", "body": "template <typename ${1:T}>$0", "title": "template" },
    { "trigger": "namespace", "body": "namespace ${1:name} {\n$0\n}", "title": "namespace" },
    { "trigger": "enum", "body": "enum class ${1:Name} {\n    $0\n};", "title": "enum class" },
    { "trigger": "void", "body": "void ${1:name}(${2}) {\n    $0\n}", "title": "void function" },
    { "trigger": "if", "body": "if (${1:condition}) {\n    $0\n}", "title": "if" },
    { "trigger": "if", "body": "if (${1:condition}) {\n    $0\n} else {\n}", "title": "if/else" },
    { "trigger": "else", "body": "else {\n    $0\n}", "title": "else" },
    { "trigger": "else", "body": "else if (${1:condition}) {\n    $0\n}", "title": "else if" },
    { "trigger": "for", "body": "for (int i = 0; i < ${1:n}; ++i) {\n    $0\n}", "title": "for loop" },
    { "trigger": "for", "body": "for (const auto& ${1:item} : ${2:items}) {\n    $0\n}", "title": "range for" },
    { "trigger": "while", "body": "while (${1:condition}) {\n    $0\n}", "title": "while" },
    { "trigger": "do", "body": "do {\n    $0\n} while (${1:condition});", "title": "do/while" },
    { "trigger": "switch", "body": "switch (${1:value}) {\n    case ${2:1}:\n        $0\n        break;\n    default:\n        break;\n}", "title": "switch" },
    { "trigger": "try", "body": "try {\n    $0\n} catch (const std::exception& e) {\n    std::cerr << e.what() << '\\n';\n}", "title": "try/catch" },
    { "trigger": "cout", "body": "cout << $0 << '\\n';", "title": "cout <<" },
    { "trigger": "cin", "body": "cin >> $0;", "title": "cin >>" },
    { "trigger": "vector", "body": "vector<${1:int}> ${2:v};$0", "title": "vector" },
    { "trigger": "sort", "body": "sort(${1:v}.begin(), ${1:v}.end());$0", "title": "sort a container" },
    { "trigger": "auto", "body": "auto ${1:f} = [&](${2}) {\n    $0\n};", "title": "lambda" },
    { "trigger": "throw", "body": "throw std::runtime_error(\"$0\");", "title": "throw runtime_error" } ] }
