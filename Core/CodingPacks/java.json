    { "trigger": "private", "body": "private ${1:void} ${2:name}(${3}) {\n    $0\n}", "title": "private method" },
    { "trigger": "class", "body": "class ${1:Name} {\n    $0\n}", "title": "class" },
    { "trigger": "interface", "body": "interface ${1:Name} {\n    $0\n}", "title": "interface" },
    { "trigger": "enum", "body": "enum ${1:Name} {\n    $0\n}", "title": "enum" },
    { "trigger": "record", "body": "record ${1:Name}(${2:int x}) {\n    $0\n}", "title": "record" },
    { "trigger": "if", "body": "if (${1:condition}) {\n    $0\n}", "title": "if" },
    { "trigger": "if", "body": "if (${1:condition}) {\n    $0\n} else {\n}", "title": "if/else" },
    { "trigger": "else", "body": "else {\n    $0\n}", "title": "else" },
    { "trigger": "else", "body": "else if (${1:condition}) {\n    $0\n}", "title": "else if" },
    { "trigger": "for", "body": "for (int i = 0; i < ${1:n}; i++) {\n    $0\n}", "title": "for loop" },
    { "trigger": "for", "body": "for (${1:var} ${2:item} : ${3:items}) {\n    $0\n}", "title": "for-each" },
    { "trigger": "while", "body": "while (${1:condition}) {\n    $0\n}", "title": "while" },
    { "trigger": "do", "body": "do {\n    $0\n} while (${1:condition});", "title": "do/while" },
    { "trigger": "switch", "body": "switch (${1:value}) {\n    case ${2:1}:\n        $0\n        break;\n    default:\n        break;\n}", "title": "switch" },
    { "trigger": "try", "body": "try {\n    $0\n} catch (${1:Exception} e) {\n    ${2:e.printStackTrace();}\n}", "title": "try/catch" },
    { "trigger": "System", "body": "System.out.println($0);", "title": "System.out.println" },
    { "trigger": "import", "body": "import ${1:java.util.*};$0", "title": "import" },
    { "trigger": "package", "body": "package ${1:com.example};$0", "title": "package" },
    { "trigger": "throw", "body": "throw new ${1:IllegalArgumentException}(\"$0\");", "title": "throw new …" },
    { "trigger": "List", "body": "List<${1:Integer}> ${2:list} = new ArrayList<>();$0", "title": "new ArrayList" },
    { "trigger": "Map", "body": "Map<${1:String}, ${2:Integer}> ${3:map} = new HashMap<>();$0", "title": "new HashMap" },
    { "trigger": "Scanner", "body": "Scanner ${1:scanner} = new Scanner(System.in);$0", "title": "Scanner on System.in" } ] }
