               "IOException", "Override", "println", "printf", "length", "size", "equals", "toString"],
  "snippets": [
    { "trigger": "public", "body": "public class ${1:Main} {\n    $0\n}", "title": "public class" },
    { "trigger": "public", "body": "public static void main(String[] args) {\n    $0\n}", "title": "main method" },
