{ "language": "c", "title": "C", "version": "1.0.0",
  "keywords": ["auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum", "extern",
               "float", "for", "goto", "if", "inline", "int", "long", "register", "restrict", "return", "short",
               "signed", "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void", "volatile",
               "while", "_Alignas", "_Alignof", "_Atomic", "_Bool", "_Complex", "_Generic", "_Imaginary", "_Noreturn",
               "_Static_assert", "_Thread_local",
               "bool", "true", "false",
               "include", "define", "ifdef", "ifndef", "endif", "pragma", "undef",
               "stdio", "stdlib", "stdbool", "stdint",
               "puts", "putchar", "getchar", "sprintf", "snprintf", "fgets", "fopen", "fclose", "stdin", "stdout",
               "stderr", "calloc", "realloc", "free", "memset", "memcpy", "strlen", "strcmp", "strncmp", "strcpy",
               "strncpy", "strcat", "exit", "abs", "qsort", "assert", "NULL", "EOF", "EXIT_SUCCESS", "EXIT_FAILURE",
               "size_t", "FILE", "int32_t", "uint32_t", "int64_t", "uint64_t", "uint8_t"],
  "snippets": [
    { "trigger": "int", "body": "int main(void) {\n    $0\n    return 0;\n}", "title": "main function" },
    { "trigger": "int", "body": "int main(int argc, char *argv[]) {\n    $0\n    return 0;\n}", "title": "main with arguments" },
    { "trigger": "include", "body": "include <${1:stdio.h}>$0", "title": "#include <…>" },
    { "trigger": "include", "body": "include \"${1:header.h}\"$0", "title": "#include \"…\"" },
    { "trigger": "define", "body": "define ${1:NAME} ${2:value}$0", "title": "#define" },
    { "trigger": "ifndef", "body": "ifndef ${1:HEADER_H}\n#define ${1:HEADER_H}\n\n$0\n\n#endif", "title": "include guard" },
    { "trigger": "if", "body": "if (${1:condition}) {\n    $0\n}", "title": "if" },
    { "trigger": "if", "body": "if (${1:condition}) {\n    $0\n} else {\n}", "title": "if/else" },
    { "trigger": "else", "body": "else {\n    $0\n}", "title": "else" },
    { "trigger": "else", "body": "else if (${1:condition}) {\n    $0\n}", "title": "else if" },
    { "trigger": "for", "body": "for (int i = 0; i < ${1:n}; i++) {\n    $0\n}", "title": "for loop" },
    { "trigger": "while", "body": "while (${1:condition}) {\n    $0\n}", "title": "while" },
    { "trigger": "do", "body": "do {\n    $0\n} while (${1:condition});", "title": "do/while" },
    { "trigger": "switch", "body": "switch (${1:value}) {\n    case ${2:1}:\n        $0\n        break;\n    default:\n        break;\n}", "title": "switch" },
    { "trigger": "struct", "body": "struct ${1:name} {\n    $0\n};", "title": "struct" },
    { "trigger": "typedef", "body": "typedef struct {\n    $0\n} ${1:Name};", "title": "typedef struct" },
    { "trigger": "enum", "body": "enum ${1:name} {\n    $0\n};", "title": "enum" },
    { "trigger": "void", "body": "void ${1:name}(${2:void}) {\n    $0\n}", "title": "void function" },
    { "trigger": "printf", "body": "printf(\"$0\\n\");", "title": "printf" },
    { "trigger": "fprintf", "body": "fprintf(stderr, \"$0\\n\");", "title": "fprintf to stderr" },
    { "trigger": "scanf", "body": "scanf(\"${1:%d}\", &${2:x});$0", "title": "scanf" },
    { "trigger": "malloc", "body": "malloc(${1:n} * sizeof(${2:int}))$0", "title": "malloc array" } ] }
