      "id": "commands.custom",
      "items": [],
      "kind": "items",
      "label": "Custom @ Commands",
      "schema": [
       {
        "id": "name",
        "kind": "text",
        "label": "Name",
        "placeholder": "Letters only, e.g. py"
       },
       {
        "choices": [
         {
          "label": "AI instruction",
          "value": "prompt"
         },
         {
          "label": "Run a program",
          "value": "run"
         },
         {
          "label": "Run in a terminal",
          "value": "terminal"
         },
         {
          "label": "Open a web page",
          "value": "link"
         },
         {
          "label": "Insert text",
          "value": "snippet"
         }
        ],
        "id": "type",
        "kind": "choice",
        "label": "What it does",
        "value": "prompt"
       },
       {
        "id": "summary",
        "kind": "text",
        "label": "Description",
        "optional": true,
        "placeholder": "Shown in the command list (optional)"
       },
       {
        "help": "Tell the AI what to do with the text after the command, e.g. \"Write a short, polite reply to the user's message.\" The answer appears in the candidates; Enter inserts it.",
        "id": "prompt",
        "kind": "text",
        "label": "AI instruction",
        "multiline": true,
        "when": {
         "type": [
          "prompt"
         ]
        }
       },
       {
        "help": "The text after the command replaces {input}; {label?} is a blank, filled in order, separated by commas; write {{ for {",
        "id": "text",
        "kind": "text",
        "label": "Insert text",
        "multiline": true,
        "when": {
         "type": [
          "snippet"
         ]
        }
       },
       {
        "help": "{input} becomes the text after the command (encoded), after the ?. The action key opens it in the browser; nothing is inserted. https:// only.",
        "id": "url",
        "kind": "text",
        "label": "Address",
        "placeholder": "https://www.google.com/search?q={input}",
        "when": {
         "type": [
          "link"
         ]
        }
       },
       {
        "help": "{input} becomes the text after the command, always as one argument, never through a shell (for one, write cmd /c {input}). Quote arguments with spaces.",
        "id": "argv",
        "kind": "words",
        "label": "Command",
        "ordered": true,
        "placeholder": "python3 -c {input}",
        "when": {
         "type": [
          "run",
          "terminal"
         ]
        }
       },
       {
        "help": "Send the text to standard input (no {input} needed)",
        "id": "stdin",
        "kind": "text",
        "label": "Standard input",
        "optional": true,
        "placeholder": "{input}",
        "when": {
         "type": [
          "run"
         ]
        }
       },
       {
        "id": "timeoutSeconds",
        "kind": "number",
        "label": "Stop after (seconds)",
        "max": 120,
        "min": 1,
        "optional": true,
        "placeholder": "10",
        "step": 1,
        "when": {
         "type": [
          "run"
         ]
        }
       },
       {
        "id": "ascii",
        "kind": "toggle",
        "label": "Type English letters (for code and paths)",
        "optional": true,
        "when": {
         "type": [
          "prompt",
          "run",
          "terminal",
          "link"
         ]
        }
