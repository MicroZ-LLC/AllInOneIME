    "Forgotten, they get it again; one that still refuses it is remembered again." : {
      "comment" : "忘掉后会重新发给它们；仍不接受的会再记住。 — Sources/AllInOneIME/SettingsWindow.swift",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Vergessen bekommen sie sie wieder; ein Modell, das sie weiterhin ablehnt, wird wieder gemerkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al olvidarlos, vuelven a recibirla; si alguno la sigue rechazando, se recuerda otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois oubliés, ils la reçoivent de nouveau ; un modèle qui la refuse encore est de nouveau mémorisé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘れると再び送ります。まだ受け付けないモデルは、また記憶します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잊으면 다시 보냅니다. 여전히 받지 않는 모델은 다시 기억합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao esquecer, eles voltam a recebê-la; um modelo que ainda a recusar é lembrado outra vez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘掉後會重新傳給它們；仍不接受的會再記住。"
          }
        }
