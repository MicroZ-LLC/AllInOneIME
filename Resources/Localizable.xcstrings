        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 후에도 이 소스의 확장 프로그램 제안이 계속 실행됩니다. 팀 저장소처럼 신뢰하는 소스에서만 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sugestões das extensões dela continuam funcionando depois das atualizações; ative só para uma fonte em que você confia, como o repositório da sua equipe."
          }
