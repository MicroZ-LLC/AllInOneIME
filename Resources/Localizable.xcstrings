          "stringUnit" : {
            "state" : "translated",
            "value" : "이제는 선택할 수 없습니다. 기본적으로 각 플러그인이나 명령이 삽입할 내용을 정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pode mais ser escolhido; por padrão, cada plug-in ou comando define o que é inserido."
