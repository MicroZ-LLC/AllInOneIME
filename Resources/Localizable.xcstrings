        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca sincronizados: a sessão do AllInOneIME Cloud, fontes de extensões, pastas de extensões e plug-ins, os apps sem erros de digitação e os apps recentes, estado das janelas. Cada Mac decide por conta própria se sincroniza, e o quê."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不同步：AllInOneIME Cloud 的登入資訊、擴充功能來源、擴充功能檔案夾和外掛、不打錯字的 App 和最近使用的 App、視窗狀態。每台 Mac 各自決定是否同步，以及同步哪些項目。"
          }
        }
      }
