          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicado em um ou dois segundos: os dicionários são implantados de novo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一兩秒內生效：詞庫會重新部署。"
          }
        }
      }
    },
    "Applies to requests to your AI service; @agent, plugins that fetch from or open a website (@stock, @x) and script extensions send text as typed." : {
      "comment" : "只用于发给你的 AI 服务的请求；@agent、从网站取数据或打开网站的插件（@stock、@x）和脚本扩展照原样发送文字。 — Sources/AllInOneIME/PrivacySettings.swift",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
