      }
    },
    "This uses your own git and SSH setup; check that git ls-remote %@ works in Terminal." : {
      "comment" : "这里用的是你自己的 git 和 SSH 设置；先在终端里确认 git ls-remote %@ 能用。 — Sources/AllInOneIME/ExtensionSourceController.swift",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier wird dein eigenes git- und SSH-Setup verwendet; prüfe, ob git ls-remote %@ im Terminal funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto usa tu propia configuración de git y SSH; comprueba que git ls-remote %@ funciona en Terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération utilise votre propre configuration git et SSH ; vérifiez que git ls-remote %@ fonctionne dans Terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のgitとSSHの設定を使います。ターミナルでgit ls-remote %@が動作するか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
