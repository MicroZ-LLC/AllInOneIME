        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlez anglais en mode anglais et chinois en mode chinois. Le texte est inséré, ou ajouté après la commande @ que vous écrivez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英語モードでは英語、中国語モードでは中国語で話します。テキストはそのまま入力されるか、入力中の@コマンドのあとに入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영어 모드에서는 영어로, 중국어 모드에서는 중국어로 말하세요. 텍스트는 바로 입력되거나, 작성 중인 @ 명령 뒤에 들어갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale inglês no modo inglês e chinês no modo chinês. O texto é inserido diretamente ou depois do comando @ que você está escrevendo."
