        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手を止めるたびに、カーソルの前の最大1,500文字（と後ろの最大200文字）を%@に送ります。機密情報はいつもどおり隠します。"
          }
        },
        "ko" : {
          "stringUnit" : {
